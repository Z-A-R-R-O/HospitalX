{
  "name": "hospitalx",
  "private": true,
  "version": "0.1.0",
  "bin": { "hx": "./hx.js", "veyminore": "./veyminore.js", "vym": "./veyminore.js" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "migrate": "node --env-file=.env.local scripts/migrate-drizzle.js",
    "seed": "tsx --env-file=.env.local scripts/seed-demo.ts",
    "seed:legacy": "node --env-file=.env.local scripts/seed.js",
    "hx": "node hx.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:security && npm run test:workflows && npm run test:reliability",
    "test:unit": "node --test tests/*.test.js",
    "test:integration": "node --test tests/migration-foundation.test.js",
    "test:security": "tsx --test tests/security/*.test.ts",
    "test:workflows": "tsx --test tests/workflows/*.test.ts",
    "test:reliability": "tsx --test tests/reliability/*.test.ts",
    "test:e2e": "playwright test",
    "test:offline": "playwright test tests/offline-sync.spec.ts",
    "verify": "npm test && npm run test:e2e && npx tsc --noEmit && npm run build",
    "native:sync": "npx cap sync android",
    "dev:android": "npx cap run android",
    "build:android": "npx cap sync android && node scripts/build-android.mjs",
    "dev:desktop": "npx tauri dev",
    "build:desktop": "npx tauri build",
    "build:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-setup.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@clerk/nextjs": "^7.9.4",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.3",
    "framer-motion": "^12.10.5",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "next": "^15.5.26",
    "page-mascot": "^0.1.0",
    "react": "^19.1.4",
    "react-dom": "^19.1.4",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "22.15.21",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "5.8.3"
  },
  "main": "veyminore.js"
}
